#!/bin/sh
# ============================================================
# usb0 DHCP Hook — 自动管理 table 200 路由
# 路径: /etc/dhcpcd.exit-hook
# ============================================================

[ "$interface" = "usb0" ] || exit 0

case "$reason" in
    BOUND|RENEW|REBIND|REBOOT|STATIC)
        ip route flush table 200 2>/dev/null || true

        # DHCP 获取的本地子网路由
        if [ -n "$new_network_number" ] && [ -n "$new_subnet_cidr" ]; then
            ip route add "${new_network_number}/${new_subnet_cidr}" dev usb0 src "$new_ip_address" table 200
        elif [ -n "$new_ip_address" ]; then
            ip route add "${new_ip_address%.*}.0/24" dev usb0 src "$new_ip_address" table 200
        fi

        # 默认路由走手机
        for gw in $new_routers; do
            ip route add default via "$gw" dev usb0 table 200
            logger -t dhcpcd-hook "usb0: table 200 default via $gw"
            break
        done

        # 静态路由（Mihomo TUN 回包 + LAN 回包）
        ip route add 198.18.0.0/16 dev utun table 200 2>/dev/null || true
        ip route add 192.168.100.0/24 dev enp2s0 table 200 2>/dev/null || true
        ;;

    STOP|RELEASE|FAIL|EXPIRE|NOCARRIER)
        ip route flush table 200 2>/dev/null || true
        logger -t dhcpcd-hook "usb0: table 200 flushed ($reason)"
        ;;
esac
