#!/bin/bash
# ============================================================
# setup-policy-routing — 创建策略路由规则
# 路径: /usr/local/sbin/setup-policy-routing
# 在 Mihomo 启动并创建 utun 后执行
# ============================================================
set -e

echo "[setup-policy-routing] Setting up policy routing..."

# 等待 utun 就绪
for i in $(seq 1 30); do
    if ip link show utun >/dev/null 2>&1; then
        echo "  utun detected after ${i}s"
        break
    fi
    sleep 1
done

if ! ip link show utun >/dev/null 2>&1; then
    echo "  WARNING: utun not found after 30s, continuing anyway..."
fi

# --- 清理旧规则 ---
while ip rule del fwmark 0x1 lookup 100 2>/dev/null; do true; done
while ip rule del fwmark 0x100 lookup 200 2>/dev/null; do true; done

# --- Table 100: 国外流量 → utun (Mihomo TUN) ---
ip route flush table 100 2>/dev/null || true
ip route add default dev utun table 100 2>/dev/null || true
ip route add 198.18.0.0/16 dev utun table 100 2>/dev/null || true
ip route add 192.168.100.0/24 dev enp2s0 table 100 2>/dev/null || true
echo "  Table 100: default dev utun"

# --- 创建策略规则 ---
ip rule add fwmark 0x1 lookup 100 priority 100
echo "  ip rule: fwmark 0x1 -> table 100"

# Table 200 由 dhcpcd exit hook 管理（usb0 DHCP 时填充）
# 这里只创建规则
ip rule add fwmark 0x100 lookup 200 priority 200
echo "  ip rule: fwmark 0x100 -> table 200"

# 如果有 usb0 路由则显示
if ip route show table 200 | grep -q .; then
    echo "  Table 200 routes:"
    ip route show table 200 | while read line; do echo "    $line"; done
else
    echo "  Table 200: waiting for usb0 DHCP..."
fi

echo "  Done."
