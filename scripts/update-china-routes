#!/bin/bash
# ============================================================
# update-china-routes — 下载中国 IPv4 CIDR 列表，更新 ipset
# 路径: /usr/local/sbin/update-china-routes
# 定时: systemd timer 每周一次
# ============================================================
set -e

IPSET_NAME="china_ipv4"
CHNROUTE_URL="https://raw.githubusercontent.com/17mon/china_ip_list/master/china_ip_list.txt"
TMPFILE=$(mktemp)

cleanup() { rm -f "$TMPFILE"; }
trap cleanup EXIT

echo "[update-china-routes] Downloading China IP list..."

# 下载（多个源做 fallback）
for url in \
    "$CHNROUTE_URL" \
    "https://ghproxy.net/$CHNROUTE_URL"; do
    if curl -sL --connect-timeout 10 --max-time 120 "$url" -o "$TMPFILE" 2>/dev/null; then
        if [ -s "$TMPFILE" ]; then
            echo "  Downloaded from $url ($(wc -l < "$TMPFILE") lines)"
            break
        fi
    fi
done

if [ ! -s "$TMPFILE" ]; then
    echo "ERROR: Failed to download China IP list"
    exit 1
fi

# 过滤有效 CIDR
grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$' "$TMPFILE" > "${TMPFILE}.clean"
mv "${TMPFILE}.clean" "$TMPFILE"

COUNT=$(wc -l < "$TMPFILE")
echo "  Valid CIDRs: $COUNT"

# 加载到 ipset
if ! ipset list -n "$IPSET_NAME" >/dev/null 2>&1; then
    ipset create "$IPSET_NAME" hash:net family inet hashsize 4096 maxelem 65536
    echo "  Created ipset $IPSET_NAME"
fi

# 用临时 ipset 做原子替换
TMP_SET="${IPSET_NAME}_tmp"
ipset create "$TMP_SET" hash:net family inet hashsize 4096 maxelem 65536 2>/dev/null || ipset flush "$TMP_SET"

while IFS= read -r cidr; do
    ipset add "$TMP_SET" "$cidr" 2>/dev/null || true
done < "$TMPFILE"

# 原子替换
ipset swap "$TMP_SET" "$IPSET_NAME"
ipset destroy "$TMP_SET" 2>/dev/null || true

# 持久化
mkdir -p /etc/ipset.conf.d 2>/dev/null || true
ipset save > /etc/ipset.conf
# 也保存到 netfilter-persistent 目录
if [ -d /etc/iptables ]; then
    ipset save > /etc/iptables/ipset.conf 2>/dev/null || true
fi

FINAL_COUNT=$(ipset list "$IPSET_NAME" | grep "Number of entries" | awk '{print $4}')
echo "  Done. ipset $IPSET_NAME has $FINAL_COUNT entries"
